{
  "name": "comacita",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Comacita: plataforma de fidelización marca blanca.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --clear-screen=false dev/server.ts",
    "dev:web": "npm run dev -w @comacita/web",
    "build": "npm run build -w @comacita/web",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx packages/db/src/migrate-neon.ts",
    "db:seed": "tsx packages/db/src/seed-neon.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@hono/node-server": "^1.14.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
